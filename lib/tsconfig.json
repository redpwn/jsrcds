{
  "compilerOptions": {
    // Base Options recommended for all projects
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "esnext",
    "experimentalDecorators": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Enable strict type checking so you can catch bugs early
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // We are not transpiling, so preserve our source code and do not emit files
    "module": "preserve",
    "noEmit": true,
    "lib": ["esnext"],
    "paths": {
      "@rcds/config": ["./src/config"],
      "@rcds/loader": ["./src/loader"],
      "@rcds/plugin": ["./src/plugin"],
      "@rcds/registry": ["./src/registry"],
      "@rcds/deployment": ["./src/deployment"]
    }
  },
  // Include the necessary files for your project
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
